---
import StickyNav from '../components/StickyNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config/site';
import { getLanguageFromPath, getPathWithoutLanguage, languageMeta, languages, localizePath, ui, type Language } from '../lib/i18n';
import type { JsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  path?: string;
  robots?: string;
  ogType?: 'article' | 'website';
  socialImage?: string;
  structuredData?: JsonLd | JsonLd[];
}

const {
  title,
  description = siteConfig.description,
  lang = getLanguageFromPath(Astro.url.pathname),
  path = getPathWithoutLanguage(Astro.url.pathname),
  robots = 'index, follow',
  ogType = 'website',
  socialImage = siteConfig.socialImage,
  structuredData
} = Astro.props;
const canonical = new URL(localizePath(path, lang), Astro.site);
const alternateLinks = languages.map((language) => ({
  language,
  href: new URL(localizePath(path, language), Astro.site)
}));
const labels = ui[lang];
---

<!doctype html>
<html lang={languageMeta[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={languageMeta[link.language].htmlLang} href={link.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, 'en'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languageMeta[lang].locale.replace('-', '_')} />
    {alternateLinks.filter((link) => link.language !== lang).map((link) => <meta property="og:locale:alternate" content={languageMeta[link.language].locale.replace('-', '_')} />)}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage ? <meta property="og:image" content={new URL(socialImage, Astro.site)} /> : null}
    {socialImage ? <meta property="og:image:alt" content={title} /> : null}
    {socialImage ? <meta name="twitter:image" content={new URL(socialImage, Astro.site)} /> : null}
    {socialImage ? <meta name="twitter:image:alt" content={title} /> : null}
    {structuredData ? <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} /> : null}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('site-theme');
        const theme = saved === 'light' || saved === 'dark' ? saved : 'system';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skipLink}</a>
    <div class="site-frame">
      <StickyNav lang={lang} path={path} />
      <main id="main-content"><slot /></main>
      <SiteFooter lang={lang} />
    </div>
  </body>
</html>
