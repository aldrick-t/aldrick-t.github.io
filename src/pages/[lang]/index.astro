---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePageContent from '../../components/HomePageContent.astro';
import { siteConfig } from '../../config/site';
import { localizedLanguages, localizePath, ui, type LocalizedLanguage } from '../../lib/i18n';
import { buildProfileSchema } from '../../lib/seo';

export function getStaticPaths() {
  return localizedLanguages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocalizedLanguage;
const labels = ui[lang];
const pageUrl = new URL(localizePath('/', lang), Astro.site).toString();
---

<BaseLayout title={`${siteConfig.name} — ${labels.site.title}`} description={labels.site.description} lang={lang} path="/" structuredData={buildProfileSchema(pageUrl, lang)}>
  <HomePageContent lang={lang} />
</BaseLayout>
