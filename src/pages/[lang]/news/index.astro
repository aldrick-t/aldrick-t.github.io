---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsPageContent from '../../../components/NewsPageContent.astro';
import { siteConfig } from '../../../config/site';
import { localizedLanguages, ui, type LocalizedLanguage } from '../../../lib/i18n';

export function getStaticPaths() {
  return localizedLanguages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocalizedLanguage;
const labels = ui[lang];
---

<BaseLayout title={`${labels.newsPage.title} — ${siteConfig.name}`} description={labels.newsPage.description} lang={lang} path="/news">
  <NewsPageContent lang={lang} />
</BaseLayout>
