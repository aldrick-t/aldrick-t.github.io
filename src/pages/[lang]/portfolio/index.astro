---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortfolioPageContent from '../../../components/PortfolioPageContent.astro';
import { siteConfig } from '../../../config/site';
import { getPublishedLocalizedItems } from '../../../lib/localized-items';
import { getItemSlug } from '../../../lib/items';
import { itemPath, localizedLanguages, localizePath, ui, type LocalizedLanguage } from '../../../lib/i18n';
import { buildCollectionSchema } from '../../../lib/seo';

export function getStaticPaths() {
  return localizedLanguages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocalizedLanguage;
const labels = ui[lang];
const items = await getPublishedLocalizedItems(lang, (item) => item.data.portfolio);
const pageUrl = new URL(localizePath('/portfolio', lang), Astro.site).toString();
const structuredData = buildCollectionSchema(
  pageUrl,
  labels.portfolioPage.title,
  labels.portfolioPage.description,
  items.map((item) => ({ name: item.data.title, url: new URL(itemPath(getItemSlug(item), lang), Astro.site).toString() })),
  lang
);
---

<BaseLayout title={`${labels.portfolioPage.title} — ${siteConfig.name}`} description={labels.portfolioPage.description} lang={lang} path="/portfolio" structuredData={structuredData}>
  <PortfolioPageContent lang={lang} />
</BaseLayout>
