---
import { getItemSlug, type ItemEntry } from '../lib/items';
import { getGeneratedPdfThumbnailPath, getPdfSourceUrl, getYouTubeEmbedUrl } from '../lib/media';

interface Props {
  item: ItemEntry;
}

const { item } = Astro.props;
const slug = getItemSlug(item);
const assets = item.data.assets ?? [];
const explicitMedia = item.data.media ?? [];
const links = item.data.links ?? [];
const assetMedia = assets.map((asset) => ({ kind: 'image' as const, ...asset }));
const videoLinkMedia = links
  .filter((link) => link.kind === 'video')
  .map((link) => ({ kind: 'youtube' as const, url: link.url, title: link.label, caption: undefined }));
const media = [...explicitMedia, ...assetMedia, ...videoLinkMedia];
---

{media.length ? (
  <div class="item-media-grid">
    {media.map((entry) => {
      if (entry.kind === 'image') {
        return (
          <figure class="item-media-card">
            <img src={entry.path} alt={entry.alt} loading="lazy" decoding="async" />
            {entry.caption || entry.credit ? <figcaption>{entry.caption}{entry.caption && entry.credit ? ' · ' : ''}{entry.credit}</figcaption> : null}
          </figure>
        );
      }

      if (entry.kind === 'youtube') {
        const embedUrl = getYouTubeEmbedUrl(entry.url);
        return embedUrl ? (
          <figure class="item-media-card item-media-card--video">
            <iframe
              src={embedUrl}
              title={entry.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
            {entry.caption ? <figcaption>{entry.caption}</figcaption> : null}
          </figure>
        ) : null;
      }

      const pdfUrl = getPdfSourceUrl(entry);
      const thumbnail = entry.thumbnail?.path ?? (entry.path ? getGeneratedPdfThumbnailPath(slug, entry.path) : undefined);
      const thumbnailAlt = entry.thumbnail?.alt ?? `${entry.title} first page preview`;

      return pdfUrl ? (
        <figure class="item-media-card item-media-card--pdf">
          <a class="item-media-card__pdf-link" href={pdfUrl} target="_blank" rel="noreferrer noopener" aria-label={`Open PDF: ${entry.title}`}>
            {thumbnail ? (
              <span class="item-media-card__pdf-preview">
                <img src={thumbnail} alt={thumbnailAlt} loading="lazy" decoding="async" />
                <span class="item-media-card__pdf-badge">PDF</span>
              </span>
            ) : (
              <span class="item-media-card__pdf-fallback">
                <span class="item-media-card__pdf-badge">PDF</span>
                <strong>{entry.title}</strong>
              </span>
            )}
          </a>
          <figcaption><strong>{entry.title}</strong>{entry.caption ? ` · ${entry.caption}` : ''}</figcaption>
        </figure>
      ) : null;
    })}
  </div>
) : null}
