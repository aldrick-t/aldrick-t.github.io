---
import { siteConfig } from '../config/site';
import {
  getLocalizedMainSkillStack,
  getLocalizedSkillStack,
  getSkillIconUrls,
  mainSkillStackIds,
  mainTechStackIds
} from '../data/skills';
import { ui, localizePath, itemPath, type Language } from '../lib/i18n';
import { getPublishedLocalizedItems } from '../lib/localized-items';
import { getPublishedLocalizedNews } from '../lib/localized-news';
import { getItemSlug, sortItems } from '../lib/items';
import PortfolioGalleryCard from './PortfolioGalleryCard.astro';
import NewsList from './NewsList.astro';
import githubIcon from '../assets/icons/ui/github.svg?raw';
import linkedinIcon from '../assets/icons/ui/linkedin.svg?raw';
import emailIcon from '../assets/icons/ui/email.svg?raw';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const labels = ui[lang];
const profile = { ...siteConfig, ...labels.site };
const landingSections = [
  { id: 'intro', label: labels.home.sections.intro },
  { id: 'featured', label: labels.home.sections.featured },
  { id: 'news', label: labels.home.sections.news },
  { id: 'skills', label: labels.home.sections.skills },
  { id: 'languages', label: labels.home.sections.languages },
  { id: 'credentials', label: labels.home.sections.credentials }
] as const;
const items = await getPublishedLocalizedItems(lang);
const news = await getPublishedLocalizedNews(lang);
const mainTechStack = getLocalizedMainSkillStack(mainTechStackIds, lang);
const mainSkillStack = getLocalizedMainSkillStack(mainSkillStackIds, lang);
const fullTechStack = getLocalizedSkillStack('tech', lang);
const fullSkillStack = getLocalizedSkillStack('skill', lang);
const skillUsage = new Map(
  [...mainTechStack, ...mainSkillStack, ...fullTechStack.flatMap(({ skills }) => skills), ...fullSkillStack.flatMap(({ skills }) => skills)]
    .map((skill) => [skill.id, sortItems(items.filter((item) => (item.data.skills ?? []).includes(skill.id)))])
);
const usageLabel = (skillLabel: string) => labels.home.skills.usage.replace('{skill}', skillLabel);
const emptyUsageLabel = (skillLabel: string) => labels.home.skills.emptyUsage.replace('{skill}', skillLabel);
const featured = items.filter((item) => item.data.featuredRank).sort((a, b) => (a.data.featuredRank ?? 0) - (b.data.featuredRank ?? 0));
if (featured.length !== 3) throw new Error(`Expected exactly three featured items, found ${featured.length}.`);
const credentials = sortItems(items.filter((item) => item.data.type === 'course' || item.data.type === 'certification'));
const toInlineIcon = (icon: string) =>
  icon
    .replace(/<\?xml[^>]*>\s*/g, '')
    .replace(/<!DOCTYPE[^>]*>\s*/g, '')
    .replaceAll('#000000', 'currentColor');
const contactIcons = {
  github: toInlineIcon(githubIcon),
  linkedin: toInlineIcon(linkedinIcon),
  email: toInlineIcon(emailIcon)
} satisfies Record<(typeof profile.contactLinks)[number]['icon'], string>;
const languages = profile.languages.map((language) => ({
  ...language,
  detail: 'detail' in language ? language.detail : undefined
}));
---

<div class="shell page-stack page-stack--sticky-section-nav home-page">
  <nav class="section-nav section-nav--sticky" aria-label={labels.home.onThisPage}>
    {landingSections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
  </nav>

  <section id="intro" class="intro-panel" aria-labelledby="intro-title">
    <div class="intro-panel__main">
      <h1 id="intro-title">{profile.name}</h1>
      <p class="intro-panel__title">{profile.title}</p>
      <p class="intro-panel__summary">{profile.introduction}</p>
    </div>
    <div class="intro-panel__aside">
      <p>{profile.availability}</p>
      <div class="action-row">
        <a class="button button--primary" href={localizePath(profile.portfolioRoute, lang)}>{labels.common.portfolio}</a>
        <a class="button" href={localizePath(profile.cvRoute, lang)}>{labels.common.cv}</a>
      </div>
      <div class="intro-contact-row" aria-label={labels.common.contactLinks}>
        {profile.contactLinks.map((link) => (
          <a
            class="icon-button"
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer noopener' : undefined}
            aria-label={link.mail ? `${labels.footer.email} ${profile.name}` : `${labels.common.open} ${link.label}`}
            title={link.label}
          >
            <span set:html={contactIcons[link.icon]} />
          </a>
        ))}
      </div>
    </div>
    <section class="intro-panel__research" aria-labelledby="intro-research-title">
      <h2 id="intro-research-title" class="intro-panel__label">{labels.home.researchInterests}</h2>
      <ul class="intro-chip-list">
        {profile.researchInterests.map((interest) => <li>{interest}</li>)}
      </ul>
    </section>
  </section>

  <section id="featured" class="page-section" aria-labelledby="featured-title">
    <header class="section-heading">
      <div><h2 id="featured-title">{labels.home.sections.featured}</h2></div>
      <a href={localizePath('/portfolio', lang)}>{labels.common.allItems} →</a>
    </header>
    <div class="featured-rail">
      {featured.map((item, index) => (
        <PortfolioGalleryCard item={item} lang={lang} latestOrder={index} relevanceOrder={index} />
      ))}
    </div>
  </section>

  <section id="news" class="page-section" aria-labelledby="news-title">
    <header class="section-heading">
      <div><h2 id="news-title">{labels.home.sections.news}</h2></div>
      <a href={localizePath('/news', lang)}>{labels.newsPage.title} →</a>
    </header>
    <NewsList items={news.slice(0, 5)} lang={lang} />
  </section>

  <section id="skills" class="page-section" aria-labelledby="skills-title">
    <header class="section-heading"><div><h2 id="skills-title">{labels.home.sections.skills}</h2></div></header>
    <div class="skill-stacks">
      <section class="skill-stack" aria-labelledby="main-tech-stack-title">
        <h3 id="main-tech-stack-title">{labels.home.skills.mainTechStack}</h3>
        <div class="skill-stack__list">
          {mainTechStack.map((skill) => {
            const panelId = `main-tech-usage-${skill.id}`;
            return <button class="skill-stack__button" type="button" data-skill-trigger aria-controls={panelId} aria-expanded="false">
              <span class="skill-stack__icons" aria-hidden="true">{getSkillIconUrls(skill).map((iconUrl) => <img src={iconUrl} alt="" />)}</span>
              <span>{skill.label}</span>
            </button>;
          })}
        </div>
      </section>
      <section class="skill-stack" aria-labelledby="main-skill-stack-title">
        <h3 id="main-skill-stack-title">{labels.home.skills.mainSkillStack}</h3>
        <div class="skill-stack__list">
          {mainSkillStack.map((skill) => {
            const panelId = `main-skill-usage-${skill.id}`;
            return <button class="skill-stack__button" type="button" data-skill-trigger aria-controls={panelId} aria-expanded="false">{skill.label}</button>;
          })}
        </div>
      </section>
    </div>

    <div class="skill-usage-panels skill-usage-panels--main">
      {[...mainTechStack, ...mainSkillStack].map((skill) => {
        const panelId = `${skill.stack === 'tech' ? 'main-tech' : 'main-skill'}-usage-${skill.id}`;
        const related = skillUsage.get(skill.id) ?? [];
        return <section id={panelId} class="skill-usage" data-skill-usage hidden>
          <h4>{usageLabel(skill.label)}</h4>
          {related.length ? <ul>{related.map((item) => <li><a href={itemPath(getItemSlug(item), lang)}>{item.data.title}</a></li>)}</ul> : <p>{emptyUsageLabel(skill.label)}</p>}
        </section>;
      })}
    </div>

    <div class="skill-stacks__more">
      <button
        class="button"
        type="button"
        data-skills-toggle
        aria-controls="full-skill-stacks"
        aria-expanded="false"
      >
        <span data-skills-toggle-label data-see-more={labels.home.skills.seeMore} data-show-less={labels.home.skills.showLess}>{labels.home.skills.seeMore}</span>
        <span aria-hidden="true" data-skills-toggle-arrow>↓</span>
      </button>
    </div>

    <div id="full-skill-stacks" class="skill-stacks skill-stacks--full" data-skills-expanded hidden>
      <section class="skill-stack skill-stack--full" aria-labelledby="full-tech-stack-title">
        <h3 id="full-tech-stack-title">{labels.home.skills.fullTechStack}</h3>
        {fullTechStack.map(({ group, skills }, groupIndex) => (
          <section class="skill-stack__group" aria-labelledby={`full-tech-group-${groupIndex}`}>
            <h4 id={`full-tech-group-${groupIndex}`}>{group}</h4>
            <div class="skill-pill-list">
              {skills.map((skill) => {
                const panelId = `full-tech-usage-${skill.id}`;
                return <button class="skill-pill skill-pill--tech" type="button" data-skill-trigger aria-controls={panelId} aria-expanded="false">
                  <span class="skill-pill__icons" aria-hidden="true">{getSkillIconUrls(skill).map((iconUrl) => <img src={iconUrl} alt="" />)}</span>
                  <span>{skill.label}</span>
                </button>;
              })}
            </div>
            <div class="skill-usage-panels skill-usage-panels--group">
              {skills.map((skill) => {
                const related = skillUsage.get(skill.id) ?? [];
                return <section id={`full-tech-usage-${skill.id}`} class="skill-usage" data-skill-usage hidden>
                  <h5>{usageLabel(skill.label)}</h5>
                  {related.length ? <ul>{related.map((item) => <li><a href={itemPath(getItemSlug(item), lang)}>{item.data.title}</a></li>)}</ul> : <p>{emptyUsageLabel(skill.label)}</p>}
                </section>;
              })}
            </div>
          </section>
        ))}
      </section>
      <section class="skill-stack skill-stack--full" aria-labelledby="full-skill-stack-title">
        <h3 id="full-skill-stack-title">{labels.home.skills.fullSkillStack}</h3>
        {fullSkillStack.map(({ group, skills }, groupIndex) => (
          <section class="skill-stack__group" aria-labelledby={`full-skill-group-${groupIndex}`}>
            <h4 id={`full-skill-group-${groupIndex}`}>{group}</h4>
            <div class="skill-pill-list">
              {skills.map((skill) => {
                const panelId = `full-skill-usage-${skill.id}`;
                return <button class="skill-pill" type="button" data-skill-trigger aria-controls={panelId} aria-expanded="false">{skill.label}</button>;
              })}
            </div>
            <div class="skill-usage-panels skill-usage-panels--group">
              {skills.map((skill) => {
                const related = skillUsage.get(skill.id) ?? [];
                return <section id={`full-skill-usage-${skill.id}`} class="skill-usage" data-skill-usage hidden>
                  <h5>{usageLabel(skill.label)}</h5>
                  {related.length ? <ul>{related.map((item) => <li><a href={itemPath(getItemSlug(item), lang)}>{item.data.title}</a></li>)}</ul> : <p>{emptyUsageLabel(skill.label)}</p>}
                </section>;
              })}
            </div>
          </section>
        ))}
      </section>
    </div>
  </section>

  <section id="languages" class="page-section" aria-labelledby="languages-title">
    <header class="section-heading"><div><h2 id="languages-title">{labels.home.sections.languages}</h2></div></header>
    <div class="language-list">
      {languages.map((language) => (
        <article class="language-row">
          <h3>{language.language}</h3>
          <p>
            <span>{language.proficiency}</span>
            {language.detail ? <small>{language.detail}</small> : null}
          </p>
        </article>
      ))}
    </div>
  </section>

  <section id="credentials" class="page-section" aria-labelledby="credentials-title">
    <header class="section-heading"><div><h2 id="credentials-title">{labels.home.sections.credentials}</h2></div></header>
    <div class="row-list">
      {credentials.map((item) => {
        const link = (item.data.links ?? [])[0];
        return (
          <article class="content-row">
            <div><h3><a href={itemPath(getItemSlug(item), lang)}>{item.data.title}</a></h3><p>{item.data.organization}</p></div>
            <div class="content-row__actions">
              <time datetime={item.data.dateEnd === 'Present' ? undefined : item.data.dateEnd}>{item.data.dateEnd}</time>
              {link ? <a href={link.url} target="_blank" rel="noreferrer noopener">{labels.common.verify} {labels.common.externalSuffix}</a> : null}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</div>

<script>
  const skillsSection = document.querySelector<HTMLElement>('#skills');

  if (skillsSection) {
    const triggers = Array.from(skillsSection.querySelectorAll<HTMLButtonElement>('[data-skill-trigger]'));
    const usagePanels = Array.from(skillsSection.querySelectorAll<HTMLElement>('[data-skill-usage]'));
    const expandedStacks = skillsSection.querySelector<HTMLElement>('[data-skills-expanded]');
    const toggle = skillsSection.querySelector<HTMLButtonElement>('[data-skills-toggle]');
    const toggleLabel = skillsSection.querySelector<HTMLElement>('[data-skills-toggle-label]');
    const toggleArrow = skillsSection.querySelector<HTMLElement>('[data-skills-toggle-arrow]');

    const closeUsage = () => {
      triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
      usagePanels.forEach((panel) => { panel.hidden = true; });
    };

    triggers.forEach((trigger) => trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeUsage();
      if (isOpen) return;

      const panelId = trigger.getAttribute('aria-controls');
      const panel = panelId ? skillsSection.querySelector<HTMLElement>(`#${panelId}`) : null;
      if (!panel) return;

      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
    }));

    toggle?.addEventListener('click', () => {
      if (!expandedStacks || !toggleLabel || !toggleArrow) return;
      const isOpen = !expandedStacks.hidden;
      expandedStacks.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggleLabel.textContent = isOpen ? toggleLabel.dataset.seeMore ?? '' : toggleLabel.dataset.showLess ?? '';
      toggleArrow.textContent = isOpen ? '↓' : '↑';
      if (isOpen) closeUsage();
    });
  }
</script>
