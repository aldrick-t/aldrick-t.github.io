{
  "name": "aldrick-t-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run media:thumbnails && astro dev",
    "content:check": "node ./scripts/validate-content.mjs",
    "media:thumbnails": "node ./scripts/generate-pdf-thumbnails.mjs",
    "new:item": "node ./scripts/new-item.mjs",
    "new:news": "node ./scripts/new-news.mjs",
    "build:cv": "node ./scripts/build-cvs.mjs",
    "build": "npm run media:thumbnails && npm run content:check && astro build",
    "build:all": "npm run media:thumbnails && npm run content:check && npm run build:cv && astro build",
    "preview": "astro preview",
    "check": "npm run media:thumbnails && npm run content:check && astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.0"
  },
  "devDependencies": {
    "js-yaml": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
